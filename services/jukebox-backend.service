[Unit]
Description=Jukebox API Server
After=network.target sound.target

[Service]
Type=simple
# run as the desktop/login user that owns the audio session
User=<LOGIN>
Group=audio
WorkingDirectory=/home/<LOGIN>/jukebox
Environment=PATH=/home/<LOGIN>/jukebox/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/<LOGIN>/jukebox
Environment=VIRTUAL_ENV=/home/<LOGIN>/jukebox/venv
# point to the login user's runtime and session bus (replace <UID> with that user's UID)
Environment=PULSE_SERVER=unix:/run/user/<UID>/pulse/native
Environment=XDG_RUNTIME_DIR=/run/user/<UID>
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/<UID>/bus
ExecStart=/home/<LOGIN>/jukebox/venv/bin/python -m uvicorn src.api_server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
SupplementaryGroups=audio

[Install]
WantedBy=multi-user.target